    "start": "next start",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run validate && npm run test && npm run build",
    "validate": "node --import tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/smoke-test.ts && node --import tsx scripts/football-career-test.ts && npm run test:journeys && npm run test:ads && node --import tsx scripts/share-test.ts",
    "test:football": "node --import tsx scripts/football-career-test.ts",
    "play": "node --import tsx scripts/playthrough.ts",
    "card": "node --import tsx scripts/card-test.ts",
    "render-card": "node --import tsx scripts/render-card.tsx",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "test:journeys": "node --import tsx scripts/journey-test.ts",
    "test:ads": "node --import tsx scripts/rewarded-ads-test.ts"
  },
  "keywords": [],
